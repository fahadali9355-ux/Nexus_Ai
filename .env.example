# Gemini API Key (Required for conversational AI and tool routing)
GEMINI_API_KEY=your_gemini_api_key_here

# NewsAPI Key (Optional / Required for news headlines)
NEWSAPI_KEY=your_newsapi_key_here

# Vosk Wake Word Settings (Optional)
# Path to downloaded Vosk model directory (defaults to auto-detection or cache)
# VOSK_MODEL_PATH=./model
MIC_DEVICE_INDEX=

# Piper Neural TTS Settings (Optional)
# Voice model name inside modules/piper_voices (e.g. en_US-lessac-medium, en_US-ryan-medium)
# PIPER_VOICE_NAME=en_US-lessac-medium
# Speed factor (<1.0 is faster, e.g. 0.95 for ~200 WPM; 1.0 is standard pace)
# PIPER_LENGTH_SCALE=0.95
